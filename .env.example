# Copy to .env.local for local development. Real values live in Vercel (Settings -> Environment Variables).

# Supabase (set by the Vercel–Supabase integration)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# The integration may set these names instead (either pair works)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Search engine ownership checks (content value of each verification meta tag)
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_SEZNAM_VERIFICATION=

# Google APIs (YouTube live detection, Drive photo gallery)
YOUTUBE_API_KEY=
GOOGLE_API_KEY=
# Optional overrides for what admins set in Settings
YOUTUBE_CHANNEL_ID=
GALLERY_FOLDER_ID=

# Website emails (club Gmail with an app password, or Resend)
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=
# Comma-separated admin addresses for new sign-up and join request alerts (default: the admin list)
ADMIN_NOTIFY_EMAILS=

# Secrets for routes only machines call
# Vercel cron -> /api/keepalive (any long random string; Vercel sends it automatically)
CRON_SECRET=
# Database -> /api/hooks/join (same value as the "join_hook_secret" entry in Supabase Vault)
JOIN_HOOK_SECRET=

# Cloudflare Turnstile on the join form (free, https://dash.cloudflare.com -> Turnstile).
# The form works without them, and the check switches on as soon as both are set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
